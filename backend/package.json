{
  "name": "pos-backend",
  "version": "1.0.0",
  "description": "Backend API Server for White Label POS and Mobile Native Apps",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
